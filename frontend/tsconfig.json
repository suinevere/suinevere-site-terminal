// ----------------------
// | tsconfig.json
// | Description: TypeScript compiler configuration for the terminal frontend.
// | Author: suinevere
// | Dependencies: typescript, vitest
// | Globals: N/A
// ----------------------
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
